{
	"name": "virn-ops",
	"private": true,
	"scripts": {
		"build": "dotenv -c -- turbo build",
		"dev": "dotenv -c -- turbo dev --concurrency 15",
		"type-check": "dotenv -c -- turbo type-check",
		"start": "dotenv -c -- turbo start",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"clean": "turbo clean",
		"test": "dotenv -c -- turbo test",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"safety-check": "dotenv -c -- turbo type-check test",
		"safety-check:auth": "pnpm safety-check && pnpm --filter saas e2e:ci"
	},
	"dependencies": {
		"oxlint-tsgolint": "^0.23.0"
	},
	"devDependencies": {
		"@virn/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"dotenv-cli": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"turbo": "^2.9.12",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=20"
	},
	"packageManager": "pnpm@11.1.1",
	"pnpm": {
		"onlyBuiltDependencies": [
			"protobufjs"
		]
	}
}
