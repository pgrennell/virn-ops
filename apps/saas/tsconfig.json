{
	"extends": "@virn/tsconfig/nextjs.json",
	"compilerOptions": {
		"plugins": [{ "name": "next" }],
		"paths": {
			"@config": ["./config"],
			"@organizations/*": ["./modules/organizations/*"],
			"@auth/*": ["./modules/auth/*"],
			"@settings/*": ["./modules/settings/*"],
			"@payments/*": ["./modules/payments/*"],
			"@i18n/*": ["./modules/i18n/*"],
			"@admin/*": ["./modules/admin/*"],
			"@agents/*": ["./modules/agents/*"],
			"@vendors/*": ["./modules/vendors/*"],
			"@datasets/*": ["./modules/datasets/*"],
			"@ai/*": ["./modules/ai/*"],
			"@onboarding/*": ["./modules/onboarding/*"],
			"@runs/*": ["./modules/runs/*"],
			"@shared/*": ["./modules/shared/*"],
			"@builder/*": ["./modules/builder/*"],
			"@library/*": ["./modules/library/*"],
			"@listings/*": ["./modules/listings/*"],
			"@entitysets/*": ["./modules/entitysets/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "**/*.cjs", "**/*.mjs", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
