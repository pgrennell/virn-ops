{
	"name": "@virn/scripts",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"create:user": "dotenv -c -e ../../.env -- tsx ./src/create-user.ts",
		"seed:capabilities": "dotenv -c -e ../../.env -- tsx ./src/seed-capabilities.ts",
		"seed:settings": "dotenv -c -e ../../.env -- tsx ./src/seed-settings.ts",
		"seed:config": "pnpm seed:capabilities && pnpm seed:settings",
		"seed:demo-workflow": "dotenv -c -e ../../.env -- tsx ./src/seed-demo-workflow.ts",
		"test:config": "dotenv -c -e ../../.env -- tsx ./src/test-config-resolution.ts",
		"walk:builder": "dotenv -c -e ../../.env.local -e ../../.env -- tsx ./src/walk-builder-publish-launch.ts",
		"sla-sweep:dev": "dotenv -c -e ../../.env.local -e ../../.env -- tsx ./src/sla-sweep-dev.ts",
		"sla-sweep:dev:watch": "dotenv -c -e ../../.env.local -e ../../.env -- tsx ./src/sla-sweep-dev.ts --watch",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@virn/api": "workspace:*",
		"@virn/auth": "workspace:*",
		"@virn/database": "workspace:*",
		"@virn/logs": "workspace:*",
		"drizzle-orm": "catalog:"
	},
	"devDependencies": {
		"@virn/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"nanoid": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
