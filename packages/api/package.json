{
	"name": "@virn/api",
	"version": "0.0.0",
	"main": "./index.ts",
	"exports": {
		".": "./index.ts",
		"./modules/workflows/lib": "./modules/workflows/lib/index.ts",
		"./*": "./*.ts",
		"./*.ts": "./*.ts"
	},
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@orpc/client": "catalog:",
		"@orpc/json-schema": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"@virn/ai": "workspace:*",
		"@virn/auth": "workspace:*",
		"@virn/database": "workspace:*",
		"@virn/i18n": "workspace:*",
		"@virn/logs": "workspace:*",
		"@virn/notifications": "workspace:*",
		"@virn/payments": "workspace:*",
		"@virn/storage": "workspace:*",
		"@virn/utils": "workspace:*",
		"@sindresorhus/slugify": "catalog:",
		"hono": "catalog:",
		"nanoid": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@virn/tsconfig": "workspace:*",
		"@vitest/coverage-v8": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
